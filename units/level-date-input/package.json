{
  "name": "@kaigilb/gilbplatformcode-level-date-input",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The date field of a level's popover in the value graph: a date input that tells the host on change, Enter, blur and Escape, and shows the year alert when the host asks. The host keeps the key, the alert state and the write.",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:host-agnostic": "node ./scripts/check-host-agnostic.mjs"
  },
  "peerDependencies": {
    "@kaigilb/gilbplatformcode-date-rules": "^0.1.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@kaigilb/gilbplatformcode-date-rules": "file:../date-rules",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
