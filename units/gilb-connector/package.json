{
  "name": "@kaigilb/gilbplatformcode-gilb-connector",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "A stdio MCP server that lets Claude Code and Claudian use Kai-Zen and the other GilbPlatform agents on GilbPlatform vaults, signed in as a Connected AI by default.",
  "bin": {
    "gilb-connector": "./connector/gilb-connector.mjs"
  },
  "exports": {
    ".": "./connector/gilb-connector.mjs",
    "./vite": {
      "types": "./connector/vite-plugin.d.mts",
      "default": "./connector/vite-plugin.mjs"
    },
    "./fake-claude.mjs": "./src/fake-claude.mjs"
  },
  "files": ["src", "connector"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build:connector": "node ./scripts/build-connector.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:host-agnostic": "node ./scripts/check-host-agnostic.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.9"
  }
}
