{
  "name": "@kaigilb/gilbplatformcode-lws-session-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "The one seam through which GilbPlatform client code gets its credential headers, so the same client works with any signed-in session and never sends a credential to a host outside the platform.",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:host-agnostic": "node ./scripts/check-host-agnostic.mjs"
  },
  "devDependencies": {
    "@kaigilb/gilbplatformcode-base-origin": "file:../base-origin",
    "@kaigilb/gilbplatformcode-request-htu": "file:../request-htu",
    "@kaigilb/gilbplatformcode-signin": "file:../signin",
    "@kaigilb/gilbplatformcode-vault-origin-rule": "file:../vault-origin-rule",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@kaigilb/gilbplatformcode-base-origin": "^0.2.0",
    "@kaigilb/gilbplatformcode-request-htu": "^0.1.0",
    "@kaigilb/gilbplatformcode-signin": "^0.2.0",
    "@kaigilb/gilbplatformcode-vault-origin-rule": "^0.1.0"
  }
}
