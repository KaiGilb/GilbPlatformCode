{
  "name": "@kaigilb/gilbplatformcode-style-runtime",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Applies the app's style at start: loads one style.tokens.json, validates it, and writes the CSS custom properties with no flash. Also carries the action row (Mac-order button row) CSS, and a /react entry with ActionRow and ThemeToggle.",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:host-agnostic": "node ./scripts/check-host-agnostic.mjs"
  },
  "dependencies": {
    "culori": "^4.0.1",
    "@types/culori": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
