{
  "name": "@kaigilb/gilbplatformcode-secret-check",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Tells whether a piece of text holds a secret (a key, a token, a password, a private key block), and masks it. One check for the app and the back end.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:host-agnostic": "node ./scripts/check-host-agnostic.mjs",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
