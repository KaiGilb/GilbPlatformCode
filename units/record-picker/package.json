{
  "name": "@kaigilb/gilbplatformcode-record-picker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A search-and-pick box for records: debounced search, grouped hits, \"nothing found\", an incomplete-answer note with Try again, and mouse picking. The caller decides what is searched; the host provides the query hook once.",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:host-agnostic": "node ./scripts/check-host-agnostic.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
