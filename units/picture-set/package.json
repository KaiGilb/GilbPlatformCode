    "@kaigilb/gilbplatformcode-photo-ref": "file:../photo-ref",
    "@kaigilb/gilbplatformcode-picture-upload": "file:../picture-upload",
    "@kaigilb/gilbplatformcode-record-types": "file:../record-types",
    "@kaigilb/gilbplatformcode-refusal-detail": "file:../refusal-detail",
    "@kaigilb/gilbplatformcode-server-error": "file:../server-error",
    "@kaigilb/gilbplatformcode-signin": "file:../signin",
    "@kaigilb/gilbplatformcode-vault-origin-rule": "file:../vault-origin-rule",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@kaigilb/gilbplatformcode-lws-records": "^0.4.0",
