{
  "name": "@kaigilb/gilbplatformcode-plan-tag-picker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lets a Plan card link to another Plan record by its tag: it searches the plan vault, shows the hits, and offers to create a tagged record when the tag is free, with the host doing the search and the tag check.",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:host-agnostic": "node ./scripts/check-host-agnostic.mjs"
  },
  "peerDependencies": {
    "@kaigilb/gilbplatformcode-base-record": "^0.1.0",
    "@kaigilb/gilbplatformcode-entity-ref-value": "^0.2.0",
    "@kaigilb/gilbplatformcode-plan-links-model": "^0.2.0",
    "@kaigilb/gilbplatformcode-record-picker": "^0.1.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@kaigilb/gilbplatformcode-base-record": "file:../base-record",
    "@kaigilb/gilbplatformcode-entity-ref": "file:../entity-ref",
