    "@kaigilb/gilbplatformcode-id-tail": "file:../id-tail",
    "@kaigilb/gilbplatformcode-plan-card-facts": "file:../plan-card-facts",
    "@kaigilb/gilbplatformcode-plan-links-model": "file:../plan-links-model",
    "@kaigilb/gilbplatformcode-record-picker": "file:../record-picker",
    "@kaigilb/gilbplatformcode-relation-role": "file:../relation-role",
    "@kaigilb/gilbplatformcode-type-curie": "file:../type-curie",
    "@kaigilb/gilbplatformcode-type-key": "file:../type-key",
    "@tanstack/react-query": "^5.101.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
