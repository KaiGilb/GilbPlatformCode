{
  "name": "@kaigilb/gilbplatformcode-style-app-files",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Writes the app's style files on the developer's machine: the dev save endpoint for style.tokens.json and the logo, and the chosen fonts and fonts.css copied out of @fontsource.",
  "bin": {
    "style-app-fonts": "./bin/style-app-fonts.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    }
  },
  "files": [
    "src",
    "bin"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:host-agnostic": "node ./scripts/check-host-agnostic.mjs"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@kaigilb/gilbplatformcode-style-runtime": "file:../style-runtime",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@kaigilb/gilbplatformcode-style-runtime": "^0.2.0"
  }
}
