    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@kaigilb/gilbplatformcode-holder-reference": "^0.1.0",
    "@kaigilb/gilbplatformcode-stakeholder-field-sets": "^0.1.0",
