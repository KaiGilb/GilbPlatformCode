{
  "name": "@kaigilb/gilbplatformcode-style-studio",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "App Style Studio: a developer tool for choosing the app's colours, fonts, buttons, windows and logo, and saving them to the app's resource vault.",
