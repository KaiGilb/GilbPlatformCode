{
  "name": "@kaigilb/gilbplatformcode-type-chooser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A search-and-pick list for a GilbVeda type: a search box, planes (things, functions, values), options with their definitions, a detail view, and a note when more terms match than are shown. The caller provides the search.",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:host-agnostic": "node ./scripts/check-host-agnostic.mjs"
  },
  "peerDependencies": {
    "@kaigilb/gilbplatformcode-type-term-popover": "^0.1.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@kaigilb/gilbplatformcode-open-popups": "file:../open-popups",
    "@kaigilb/gilbplatformcode-term-origin": "file:../term-origin",
    "@kaigilb/gilbplatformcode-type-name": "file:../type-name",
    "@kaigilb/gilbplatformcode-type-picture": "file:../type-picture",
    "@kaigilb/gilbplatformcode-type-term-popover": "file:../type-term-popover",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
