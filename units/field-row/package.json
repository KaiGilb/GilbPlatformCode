{
  "name": "@kaigilb/gilbplatformcode-field-row",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One click-to-edit text field row on a card: shows the value, becomes an input on a click, commits on Enter or leaving, reverts on Escape, and does not treat a click into an open dialog or popover as leaving.",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:host-agnostic": "node ./scripts/check-host-agnostic.mjs"
  },
  "peerDependencies": {
    "@kaigilb/gilbplatformcode-card-mode": "^0.1.0",
    "@kaigilb/gilbplatformcode-open-popups": "^0.1.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@kaigilb/gilbplatformcode-card-mode": "file:../card-mode",
    "@kaigilb/gilbplatformcode-open-popups": "file:../open-popups",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
