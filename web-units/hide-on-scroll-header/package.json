{
  "name": "@kaigilb/gilbwebsitecode-hide-on-scroll-header",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A fixed site header that is clear over the hero, solid after it, slides away on scroll down but keeps its call-to-action in place, and returns on scroll up. Vue 3 / Nuxt 3.",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "check:host-agnostic": "node ./scripts/check-host-agnostic.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.14.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.10"
  }
}
