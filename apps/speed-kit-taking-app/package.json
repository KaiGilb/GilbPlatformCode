{
  "name": "speed-kit-taking-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small app that takes speed-kit from this repository and shows a vault's catalogue entries the GilbPlatform-fast way: from memory at once, from the device after a reload, refreshed behind the screen, with nothing of one person left for the next.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@kaigilb/gilbplatformcode-background-jobs": "file:../../units/background-jobs",
    "@kaigilb/gilbplatformcode-device-store": "file:../../units/device-store",
    "@kaigilb/gilbplatformcode-prefetch-registry": "file:../../units/prefetch-registry",
    "@kaigilb/gilbplatformcode-principal-hub": "file:../../units/principal-hub",
    "@kaigilb/gilbplatformcode-record-sync": "file:../../units/record-sync",
    "@kaigilb/gilbplatformcode-session-cache": "file:../../units/session-cache",
    "@kaigilb/gilbplatformcode-speed-kit": "file:../../units/speed-kit",
    "@kaigilb/gilbplatformcode-updated-line": "file:../../units/updated-line",
    "@kaigilb/gilbplatformcode-use-cached": "file:../../units/use-cached",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
