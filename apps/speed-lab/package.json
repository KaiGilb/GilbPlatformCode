{
  "name": "speed-lab",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Speed Lab: takes speed-kit from this repository and shows a vault's catalogue entries the GilbPlatform-fast way: from memory at once, from the device after a reload, refreshed behind the screen, with nothing of one person left for the next. It grows a test for every kind of speed.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "proof:browser": "node scripts/browser-proof.mjs",
    "dev:live": "node scripts/dev-live.mjs"
  },
  "dependencies": {
    "@kaigilb/gilbplatformcode-background-jobs": "file:../../units/background-jobs",
    "@kaigilb/gilbplatformcode-base-origin": "file:../../units/base-origin",
    "@kaigilb/gilbplatformcode-device-store": "file:../../units/device-store",
    "@kaigilb/gilbplatformcode-lws-session-bridge": "file:../../units/lws-session-bridge",
    "@kaigilb/gilbplatformcode-own-card": "file:../../units/own-card",
    "@kaigilb/gilbplatformcode-platform-fetch": "file:../../units/platform-fetch",
    "@kaigilb/gilbplatformcode-prefetch-registry": "file:../../units/prefetch-registry",
    "@kaigilb/gilbplatformcode-principal-hub": "file:../../units/principal-hub",
    "@kaigilb/gilbplatformcode-record-sync": "file:../../units/record-sync",
    "@kaigilb/gilbplatformcode-session-cache": "file:../../units/session-cache",
    "@kaigilb/gilbplatformcode-signin": "file:../../units/signin",
    "@kaigilb/gilbplatformcode-speed-kit": "file:../../units/speed-kit",
    "@kaigilb/gilbplatformcode-updated-line": "file:../../units/updated-line",
    "@kaigilb/gilbplatformcode-use-cached": "file:../../units/use-cached",
    "@kaigilb/gilbplatformcode-vault-origin-rule": "file:../../units/vault-origin-rule",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "^25.0.1",
    "playwright-core": "1.61.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
