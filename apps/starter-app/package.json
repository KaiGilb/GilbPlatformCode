{
  "name": "starter-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The starter app: the first code of a new GilbPlatform app. It takes the starter-app unit and adds only its own settings, its default style file and the place for the project's record screens.",
  "scripts": {
    "dev": "vite",
    "dev:fake": "vite --mode fake",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "proof:browser": "node scripts/browser-proof.mjs"
  },
  "dependencies": {
    "@kaigilb/gilbplatformcode-app-shell": "file:../../units/app-shell",
    "@kaigilb/gilbplatformcode-base-origin": "file:../../units/base-origin",
    "@kaigilb/gilbplatformcode-class-merge": "file:../../units/class-merge",
    "@kaigilb/gilbplatformcode-drawer": "file:../../units/drawer",
    "@kaigilb/gilbplatformcode-lws-session-bridge": "file:../../units/lws-session-bridge",
    "@kaigilb/gilbplatformcode-modal-sheet": "file:../../units/modal-sheet",
    "@kaigilb/gilbplatformcode-panes": "file:../../units/panes",
    "@kaigilb/gilbplatformcode-principal-row": "file:../../units/principal-row",
    "@kaigilb/gilbplatformcode-server-error": "file:../../units/server-error",
    "@kaigilb/gilbplatformcode-signin": "file:../../units/signin",
    "@kaigilb/gilbplatformcode-size-class": "file:../../units/size-class",
    "@kaigilb/gilbplatformcode-starter-app": "file:../../units/starter-app",
    "@kaigilb/gilbplatformcode-style-runtime": "file:../../units/style-runtime",
    "@kaigilb/gilbplatformcode-vault-access": "file:../../units/vault-access",
    "@kaigilb/gilbplatformcode-vault-address": "file:../../units/vault-address",
    "@kaigilb/gilbplatformcode-vault-list": "file:../../units/vault-list",
    "@kaigilb/gilbplatformcode-vault-origin-rule": "file:../../units/vault-origin-rule",
    "@kaigilb/gilbplatformcode-vault-share-sheet": "file:../../units/vault-share-sheet",
    "@kaigilb/gilbplatformcode-vault-switcher": "file:../../units/vault-switcher",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@kaigilb/gilbplatformcode-browser-proof": "file:../../units/browser-proof",
    "@kaigilb/gilbplatformcode-fake-platform": "file:../../units/fake-platform",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "6.2.6",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
